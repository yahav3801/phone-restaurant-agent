# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/restaurant_phone_agent

# RAG Search Configuration
USE_ATLAS_VECTOR_SEARCH=false  # false = client-side (local), true = Atlas Vector Search

# MongoDB Configuration
# Local development (client-side search):
# MONGODB_URI=mongodb://localhost:27017/restaurant_phone_agent

# Atlas production (vector search):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/restaurant_phone_agent?retryWrites=true&w=majority

# Atlas Vector Search Requirements:
# 1. MongoDB Atlas M10+ cluster (free tier M0 does NOT support vector search)
# 2. Vector search index created on knowledge_base collection
#    Index name: 'knowledge_base_vector_index'
#    See docs/atlas-vector-index.json for index definition
# 3. Update MONGODB_URI to Atlas connection string
# 4. Set USE_ATLAS_VECTOR_SEARCH=true
# 5. Restart application
#
# Migration Guide: See docs/atlas-migration.md

# Vapi AI
# CRITICAL: This secret is used to authenticate incoming Vapi webhooks
VAPI_WEBHOOK_SECRET=your_webhook_secret_here

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+972XXXXXXXXX

# OpenAI (for vector embeddings and intent classification)
OPENAI_API_KEY=your-api-key

# LiteLLM Proxy Configuration
# LiteLLM acts as a proxy routing requests to different LLM providers (e.g., Gemini)
# Start LiteLLM proxy: litellm --config litellm_config.yaml --port 4000
LITELLM_URL=http://localhost:4000

# Gemini API Key (used by LiteLLM for chat completions)
GEMINI_API_KEY=your-api-key

# Ngrok (for Vapi external access)
# After starting ngrok, copy the HTTPS URL here for reference
# Example: https://abc123def456.ngrok-free.app
# Update this URL in Vapi Assistant configuration
NGROK_URL=https://your-ngrok-url.ngrok-free.app

LANGFUSE_SECRET_KEY=xxxxxx
LANGFUSE_PUBLIC_KEY=xxxxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Vapi apis
VAPI_API_KEY=your-api-key
WORKFLOW_ID=your-workflow-id
PHONE_NUMBER_ID=your-phonenumber-id
# Logging (optional)
# Options: error, warn, info, debug
LOG_LEVEL=info

# Printer Configuration (optional)
PRINT_DIRECTORY=./prints

# NOTE: Meshulam/Grow.il credentials (apiKey, terminalNumber) are stored
# in the Restaurant model in MongoDB, not in environment variables.
# This allows multi-tenant support where each restaurant has their own credentials.
